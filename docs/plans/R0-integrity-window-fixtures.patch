+@dataclass(frozen=True)
+class Images:
+    workers: dict[str, str]
+    checkers: dict[str, str]
+
+
+@pytest.fixture(scope="module")
+def pinned_images() -> Images:
+    assert WORKSPACE, "Source the Phoenix workspace environment."
+    with Slots.from_environment().acquire("compile"):
+        engines = (Engine.AMD64, Engine.ARM64)
+        return Images(
+            freeze_images(engines, worker_source_digest()),
+            freeze_images(
+                engines,
+                checker_source_digest(),
+                repository=os.environ.get(
+                    "PHOENIX_WINDOW_CHECKER_REPOSITORY", "phoenix-c-integrity"
+                ),
+                source_label=CHECKER_SOURCE_LABEL,
+            ),
+        )
+
+
+@pytest.fixture
+def global_slots(isolated_workspace: None, monkeypatch: pytest.MonkeyPatch) -> None:
+    # conftest isolates unit tests. Container tests must share the real slots.
+    assert WORKSPACE
+    monkeypatch.setenv("PHOENIX_ROOT", WORKSPACE)
+
