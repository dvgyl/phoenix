+@dataclass(frozen=True)
+class ElfSection:
+    name: str
+    data: bytes
+    flags: int = 2
+    kind: int = 1
+
+
+@dataclass(frozen=True)
+class ElfSymbol:
+    name: str
+    section: str
+    offset: int
+    size: int
+
+
+def elf(sections: tuple[ElfSection, ...], symbols: tuple[ElfSymbol, ...] = ()) -> bytes:
+    """Build ELF64 section and symbol tables without a compiler."""
+    entries = list(sections)
+    links: dict[str, tuple[int, int, int]] = {}
+    if symbols:
+        strings = bytearray(b"\0")
+        table = bytearray(24)
+        for symbol in symbols:
+            section_index = next(
+                index
+                for index, item in enumerate(sections, 1)
+                if item.name == symbol.section
+            )
+            table.extend(
+                struct.pack(
+                    "<IBBHQQ",
+                    len(strings),
+                    0x11,
+                    0,
+                    section_index,
+                    0x400000 + section_index * 0x1000 + symbol.offset,
+                    symbol.size,
+                )
+            )
+            strings.extend(symbol.name.encode() + b"\0")
+        entries.extend(
+            (
+                ElfSection(".strtab", bytes(strings), 0, 3),
+                ElfSection(".symtab", bytes(table), 0, 2),
+            )
+        )
+        links[".symtab"] = (len(sections) + 1, 1, 24)
+    names = bytearray(b"\0")
+    name_offsets = []
+    for name in [item.name for item in entries] + [".shstrtab"]:
+        name_offsets.append(len(names))
+        names.extend(name.encode() + b"\0")
+    entries.append(ElfSection(".shstrtab", bytes(names), 0, 3))
+    output = bytearray(64)
+    headers = [bytes(64)]
+    for index, item in enumerate(entries, 1):
+        output.extend(bytes(-len(output) % 8))
+        offset = len(output)
+        output.extend(item.data)
+        link, info, entry_size = links.get(
+            item.name, (0, 0, 8 if item.kind in (14, 15) else 0)
+        )
+        headers.append(
+            struct.pack(
+                "<IIQQQQIIQQ",
+                name_offsets[index - 1],
+                item.kind,
+                item.flags,
+                0x400000 + index * 0x1000 if item.flags & 2 else 0,
+                offset,
+                len(item.data),
+                link,
+                info,
+                8,
+                entry_size,
+            )
+        )
+    output.extend(bytes(-len(output) % 8))
+    section_offset = len(output)
+    output.extend(b"".join(headers))
+    output[:64] = struct.pack(
+        "<16sHHIQQQIHHHHHH",
+        b"\x7fELF\x02\x01\x01" + bytes(9),
+        2,
+        62,
+        1,
+        0x401000,
+        0,
+        section_offset,
+        0,
+        64,
+        0,
+        0,
+        64,
+        len(headers),
+        len(entries),
+    )
+    return bytes(output)
+
+
+def evidence(records: tuple[Storage, ...] = ()) -> tuple[CompilerEvidence, ...]:
+    return tuple(
+        CompilerEvidence(target, "18.1.3", records, (), ORIGIN) for target in TARGETS
+    )
+
+
+def check(
+    sections: tuple[ElfSection, ...] = (),
+    symbols: tuple[ElfSymbol, ...] = (),
+    records: tuple[Storage, ...] = (),
+    original_data: bytes = b"",
+    build_index: int = 0,
+    source: dict[str, bytes] | None = None,
+) -> IntegrityReport:
+    original = elf(
+        (
+            ElfSection(".text", b"\xf1" * 17 + WINDOW + b"\xf2" * 9, 6),
+            ElfSection(".rodata", original_data),
+        )
+    )
+    clean = elf((ElfSection(".text", b"\xc3", 6),))
+    builds = [clean] * 4
+    builds[build_index] = elf((ElfSection(".text", b"\xc3", 6), *sections), symbols)
+    return check_integrity(
+        original,
+        {ARTIFACT: SOURCE} if source is None else source,
+        tuple(builds),
+        evidence(records),
+        frozenset(),
+        ORIGIN,
+    )
+
+
+def test_honest_matching_text_passes() -> None:
+    program = elf((ElfSection(".text", WINDOW, 6),))
+    report = check_integrity(
+        program, {ARTIFACT: SOURCE}, (program,) * 4, evidence(), frozenset(), ORIGIN
+    )
+    assert report.passed, report.categories
+    assert report.categories == {}
+
+
+@pytest.mark.parametrize(
+    "section,flags", [(".rodata", 2), (".data", 3), (".data.rel.ro", 3)]
+)
+@pytest.mark.parametrize("build_index", range(4))
+@pytest.mark.parametrize("prefix", [b"", b"larger-constant:"])
+def test_each_build_rejects_text_in_data(
+    section: str, flags: int, build_index: int, prefix: bytes
+) -> None:
+    report = check(
+        (ElfSection(section, prefix + WINDOW + b"suffix", flags),),
+        build_index=build_index,
+    )
+    assert not report.passed
+    assert set(report.categories) == {"embedded_text"}
+
+
+@pytest.mark.parametrize("kind", ["literal", "literal_storage", "storage"])
+@pytest.mark.parametrize("prefix", [b"", b"inside:"])
+def test_decoded_storage_rejects_text_even_with_data_provenance(
+    kind: str, prefix: bytes
+) -> None:
+    payload = prefix + WINDOW + b"end"
+    type_name = f"const unsigned char[{len(payload)}]" if kind == "storage" else ""
+    record = Storage(kind, ARTIFACT, 0, payload, type_name)
+    report = check(records=(record,), original_data=payload)
+    assert not report.passed
+    assert set(report.categories) == {"embedded_text"}
+
+
+def test_raw_source_window_is_still_rejected() -> None:
+    report = check(source={ARTIFACT: b"/*" + WINDOW + b"*/" + SOURCE})
+    assert not report.passed
+    assert set(report.categories) == {"embedded_text"}
+
+
+@pytest.mark.parametrize("symbol", RUNTIME_SYMBOLS)
+def test_runtime_symbol_range_is_excluded(symbol: str) -> None:
+    report = check(
+        (ElfSection(".data", WINDOW, 3),), (ElfSymbol(symbol, ".data", 24, 8),)
+    )
+    assert report.passed, report.categories
+
+
+@pytest.mark.parametrize("symbol", RUNTIME_SYMBOLS)
+@pytest.mark.parametrize("side", ["before", "after"])
+def test_runtime_symbol_does_not_hide_adjacent_user_data(
+    symbol: str, side: str
+) -> None:
+    payload = WINDOW + b"runtime!" if side == "before" else b"runtime!" + WINDOW
+    offset = 64 if side == "before" else 0
+    report = check(
+        (ElfSection(".data", payload, 3),), (ElfSymbol(symbol, ".data", offset, 8),)
+    )
+    assert not report.passed
+    assert set(report.categories) == {"embedded_text"}
+
+
+@pytest.mark.parametrize("symbol", RUNTIME_SYMBOLS)
+def test_zero_size_runtime_symbol_does_not_hide_user_data(symbol: str) -> None:
+    report = check(
+        (ElfSection(".data", WINDOW, 3),), (ElfSymbol(symbol, ".data", 0, 0),)
+    )
+    assert not report.passed
+    assert set(report.categories) == {"embedded_text"}
+
+
+@pytest.mark.parametrize("symbol", RUNTIME_SYMBOLS)
+def test_runtime_symbol_name_must_match_exactly(symbol: str) -> None:
