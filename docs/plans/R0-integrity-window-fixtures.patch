+
+@pytest.mark.parametrize("section,kind", [(".init_array", 14), (".fini_array", 15)])
+def test_startup_array_does_not_exempt_source_storage(section: str, kind: int) -> None:
+    record = Storage("storage", ARTIFACT, 0, WINDOW, "unsigned char[64]")
+    report = check(
+        (ElfSection(section, WINDOW, 3, kind),), records=(record,), original_data=WINDOW
+    )
+    assert not report.passed
