+ARTIFACT = "src/program.c"
+SOURCE = b"int main(void) { return 0; }\n"
+ORIGIN = (FunctionShape("main", 0, 0, 0),)
+TARGETS = ("x86_64-linux-gnu", "aarch64-linux-gnu")
+WINDOW = bytes((index * 73 + 19) % 256 for index in range(64))
+RUNTIME_SYMBOLS = (
+    "_IO_stdin_used",
+    "__dso_handle",
+    "data_start",
+    "__data_start",
