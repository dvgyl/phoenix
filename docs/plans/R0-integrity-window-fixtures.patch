+static unsigned transform(unsigned value)
+{
+    value = value * 17u + 29u;
+    value ^= value >> 3;
+    value = value * 43u + 11u;
+    return value ^ (value >> 5);
+}
+
+int main(int argc, char **argv)
+{
+    (void)argv;
+    return (int)(transform((unsigned)argc) & 127u);
+}
