+@limited("compile")
+def compile_c(
+    source: bytes, image: str, arch: str, compiler: str, *, strip: bool = False
+) -> bytes:
+    result = subprocess.run(
+        (
+            *docker_cli(),
+            "run",
+            "--rm",
+            "--interactive",
+            "--pull=never",
+            f"--platform=linux/{arch}",
+            "--network=none",
+            "--read-only",
+            "--cap-drop=ALL",
+            "--security-opt=no-new-privileges",
+            "--pids-limit=64",
+            "--memory=1536m",
+            "--memory-swap=1536m",
+            "--user=19704:19704",
+            "--tmpfs=/work:rw,noexec,nosuid,nodev,size=64m,uid=19704,gid=19704,mode=0700",
+            "--workdir=/work",
+            "--env=TMPDIR=/work",
+            "--env=HOME=/nonexistent",
+            "--env=SOURCE_DATE_EPOCH=1794268800",
+            "--entrypoint=/bin/sh",
+            image,
+            "-ec",
+            'cat > program.c; "$1" -std=c11 -pedantic-errors -Wall -Wextra '
+            "-Werror -O0 program.c -o program; "
+            'if [ "$2" = yes ]; then strip --strip-all program; fi; cat program',
+            "compile-window-fixture",
+            compiler,
+            "yes" if strip else "no",
+        ),
+        input=source,
+        capture_output=True,
+        check=False,
+        timeout=120,
+    )
+    assert result.returncode == 0, result.stderr.decode(errors="replace")
+    assert result.stdout.startswith(b"\x7fELF\x02\x01")
+    return result.stdout
+
+
+def snapshot(source: bytes) -> ProjectSnapshot:
+    archive = io.BytesIO()
+    with tarfile.open(fileobj=archive, mode="w") as output:
+        entry = tarfile.TarInfo("project/" + ARTIFACT)
+        entry.size = len(source)
+        entry.mode = 0o644
+        output.addfile(entry, io.BytesIO(source))
+    return ProjectSnapshot(((ARTIFACT, source),), archive.getvalue())
+
+
+@dataclass(frozen=True)
+class CompiledOriginal:
+    source: bytes
+    binary: bytes
+    functions: tuple[FunctionShape, ...]
+
+
+@pytest.fixture
+def compiled_original(global_slots: None, pinned_images: Images) -> CompiledOriginal:
+    source = (Path(__file__).parent / "fixtures/integrity-window/honest.c").read_bytes()
+    binary = compile_c(
+        source, pinned_images.workers["amd64"], "amd64", "gcc", strip=True
+    )
+    assert b".symtab\0" not in binary
+    return CompiledOriginal(
+        source, binary, (FunctionShape("transform", 0, 0, 0), *ORIGIN)
+    )
+
+
+def four_builds(source: bytes, images: Images) -> tuple[bytes, ...]:
+    return tuple(
+        compile_c(source, images.workers[arch], arch, compiler)
+        for arch in ("amd64", "arm64")
+        for compiler in ("gcc", "clang")
+    )
+
+
+@pytest.mark.skipif(
+    not {"amd64", "arm64"} <= COMPILER_ARCHES,
+    reason="Set PHOENIX_COMPILER_INTEGRITY_ARCHES=amd64,arm64 for pinned checks.",
+)
+class TestPinnedWindowChallenge:
+    @pytest.mark.parametrize("rename", [False, True], ids=["same-names", "renamed"])
+    def test_honest_compiler_output_passes(
+        self, compiled_original: CompiledOriginal, pinned_images: Images, rename: bool
+    ) -> None:
+        original = compiled_original
+        source = (
+            original.source.replace(b"transform", b"rebuild_value")
+            if rename
+            else original.source
+        )
+        builds = four_builds(source, pinned_images)
+        assert (
+            elf_sections(builds[0], ".text")[".text"].data
+            == elf_sections(original.binary, ".text")[".text"].data
+        )
+        facts = inspect_project(snapshot(source), pinned_images.checkers)
+        report = check_integrity(
+            original.binary,
+            {ARTIFACT: source},
+            builds,
+            facts,
+            frozenset(),
+            original.functions,
+        )
+        assert report.passed, report.categories
+
+    @pytest.mark.parametrize(
+        "qualifier,section", [("const ", ".rodata"), ("", ".data")]
+    )
+    def test_compiler_array_rejects_original_text(
+        self,
+        compiled_original: CompiledOriginal,
+        pinned_images: Images,
+        qualifier: str,
+        section: str,
+    ) -> None:
+        original = compiled_original
+        window = elf_sections(original.binary, ".text")[".text"].data[17:81]
+        assert len(window) == 64
+        values = ",".join(str(value) for value in b"prefix!" + window + b"tail")
+        source = (
+            f"static {qualifier}unsigned char payload[] = {{{values}}};\n".encode()
+            + original.source.replace(
+                b"transform((unsigned)argc)",
+                b"(transform((unsigned)argc) "
+                b"+ payload[(unsigned)argc % sizeof payload])",
+            )
+        )
+        builds = four_builds(source, pinned_images)
+        for binary in builds:
+            assert window in elf_sections(binary, section)[section].data
+        facts = inspect_project(snapshot(source), pinned_images.checkers)
+        assert all(any(window in item.data for item in fact.storage) for fact in facts)
+        report = check_integrity(
+            original.binary,
+            {ARTIFACT: source},
+            builds,
+            facts,
+            frozenset(),
+            original.functions,
+        )
+        assert not report.passed
+        assert report.categories.get("embedded_text", 0) > 0, report.categories
+
+    @pytest.mark.parametrize("section", [".init_array", ".fini_array"])
+    def test_source_cannot_request_an_excluded_section(
+        self, global_slots: None, pinned_images: Images, section: str
+    ) -> None:
+        source = (
+            f'unsigned char payload[64] __attribute__((section("{section}")))'
+            " = {1};\nint main(void) { return payload[0]; }\n"
+        ).encode()
+        with pytest.raises(IntegrityError) as failure:
+            inspect_project(snapshot(source), pinned_images.checkers)
+        assert failure.value.category == "compiler_unsupported_attribute"
