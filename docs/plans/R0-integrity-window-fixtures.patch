+def test_excluded_bytes_do_not_join_separate_user_ranges() -> None:
+    payload = WINDOW[:32] + b"runtime!" + WINDOW[32:]
+    report = check(
+        (ElfSection(".data", payload, 3),), (ElfSymbol("__dso_handle", ".data", 32, 8),)
+    )
+    assert report.passed, report.categories
