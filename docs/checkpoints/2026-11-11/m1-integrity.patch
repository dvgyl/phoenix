+        (b"64", True, True),
+        (b"63", False, False),
+        (b"63", True, False),
+    ],
+)
+def test_string_terminator_counts_only_if_stored(
+    bound: bytes, braced: bool, stores_nul: bool
+) -> None:
+    data = _TEXT[:63]
+    literal = b'"' + b"".join(rb"\%03o" % byte for byte in data) + b'"'
+    initializer = b"{" + literal + b"}" if braced else literal
+    source = b"char table[" + bound + b"] = " + initializer + b";"
+    expected = [
+        IntegrityFinding(
+            "memorized_output", _SOURCE, "c_string", source.index(literal), 63
+        )
+    ]
+    if stores_nul:
+        expected.insert(
+            0,
+            IntegrityFinding(
+                "embedded_text", _SOURCE, "c_string", source.index(literal), 64, 0
+            ),
+        )
+    assert _scan(
+        text=data + b"\0", source=source, outputs=(data, data + b"\0")
+    ) == tuple(expected)
