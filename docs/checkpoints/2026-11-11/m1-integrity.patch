+def test_blob_evidence_does_not_waive_other_rules() -> None:
+    data = b"Z" * 4097
+    source = b'char table[] = "' + data[:2048] + b'" "' + data[2048:] + b'";'
+    assert {
+        finding.rule
+        for finding in _scan(text=data[:64], source=source, outputs=(data,))
+    } == {
+        "embedded_text",
+        "memorized_output",
+        "unjustified_blob",
+    }
+    evidence = (BlobEvidence(_SOURCE, sha256(data).hexdigest(), "Codec table."),)
+    assert {
+        finding.rule
+        for finding in _scan(
+            text=data[:64], source=source, outputs=(data,), evidence=evidence
+        )
+    } == {"embedded_text", "memorized_output"}
