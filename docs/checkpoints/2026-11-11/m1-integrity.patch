+def test_blob_evidence_must_match_the_artifact_and_bytes_and_give_a_reason() -> None:
+    data = b"*" * 4097
+    digest = sha256(data).hexdigest()
+    finding = IntegrityFinding(
+        "unjustified_blob", "data.bin", "raw", 0, len(data), sha256=digest
+    )
+    assert _scan(
+        raw=data,
+        evidence=(
+            BlobEvidence("other.bin", digest, "Lookup table for the codec."),
+            BlobEvidence("data.bin", sha256(data + b"x").hexdigest(), "Old table."),
+            BlobEvidence("data.bin", digest, " \t"),
+        ),
+    ) == (finding,)
+    assert (
+        _scan(raw=data, evidence=(BlobEvidence("data.bin", digest, "Codec table."),))
+        == ()
+    )
+
