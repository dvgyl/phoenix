ARG UBUNTU_BASE=ubuntu@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
FROM ${UBUNTU_BASE} AS runtime
ARG UBUNTU_SNAPSHOT
ARG TARGETARCH
ARG CLANG18_DEB
ARG LIBCLANG_CPP18_DEB
ARG LIBLLVM18_DEB
ADD --checksum=sha256:641de77d8f142cfd62a1a6f964ba67b20754d3337c480efb529d086075a06c9a \
    https://archive.ubuntu.com/ubuntu/pool/main/c/ca-certificates/ca-certificates_20240203_all.deb \
    /opt/ubuntu-ca.deb
RUN dpkg-deb -x /opt/ubuntu-ca.deb /opt/ubuntu-ca && \
    mkdir -p /etc/ssl/certs && \
    cat /opt/ubuntu-ca/usr/share/ca-certificates/mozilla/*.crt > /etc/ssl/certs/ca-certificates.crt && \
    rm -rf /opt/ubuntu-ca /opt/ubuntu-ca.deb && \
    case "$TARGETARCH" in \
        amd64) pool=https://archive.ubuntu.com/ubuntu/ ;; \
        arm64) pool=https://ports.ubuntu.com/ubuntu-ports/ ;; \
        *) printf 'Unsupported target architecture %s.\n' "$TARGETARCH" >&2; exit 2 ;; \
    esac && \
    printf '%s\t%s\n' \
        "https://snapshot.ubuntu.com/ubuntu/$UBUNTU_SNAPSHOT/" 'priority:1' \
        "$pool" 'priority:2 type:deb' > /etc/apt/phoenix.mirrors && \
    printf '%s\n' 'Types: deb' \
        'URIs: mirror+file:/etc/apt/phoenix.mirrors' \
        'Suites: noble noble-updates noble-security' 'Components: main universe' \
        'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
        'Check-Valid-Until: no' > /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::Retries=3 --error-on=any update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        "clang-18=$CLANG18_DEB" "libclang-cpp18=$LIBCLANG_CPP18_DEB" "libllvm18=$LIBLLVM18_DEB" && \
    rm -rf /var/lib/apt/lists/*

FROM runtime AS build
ARG LIBCLANG18_DEV_DEB
ARG LLVM18_DEV_DEB
RUN apt-get -o Acquire::Retries=3 --error-on=any update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        "libclang-18-dev=$LIBCLANG18_DEV_DEB" "llvm-18-dev=$LLVM18_DEV_DEB" && \
    rm -rf /var/lib/apt/lists/*
COPY c-integrity.cc /build/c-integrity.cc
RUN clang++-18 -std=c++17 -O0 -Wall -Wextra -Werror \
        -isystem /usr/lib/llvm-18/include /build/c-integrity.cc \
        -l:libclang-cpp.so.18.1 -lLLVM-18 -Wl,--strip-all -o /phoenix-c-integrity

FROM runtime
COPY --from=build /phoenix-c-integrity /opt/phoenix/bin/phoenix-c-integrity
USER 19704:19704
ENTRYPOINT ["/opt/phoenix/bin/phoenix-c-integrity"]
