#!/bin/sh
set -eu

: "${PHOENIX_ROOT:?Source the Phoenix workspace environment.}"
case "${1:-}" in
    '') dry_run=false ;;
    --dry-run) dry_run=true ;;
    *) printf '%s\n' 'Use scripts/gc [--dry-run].' >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || exit 2

action() {
    printf 'Action:'
    printf ' <%s>' "$@"
    printf '\n'
    if ! "$dry_run"; then "$@"; fi
}

printf '%s\n' 'Free space before cleanup:'
df -h "$PHOENIX_ROOT"
repository=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if "$dry_run"; then
    uv run --locked --project "$repository" python -m phoenix_eval.run_archive gc \
        --workspace "$PHOENIX_ROOT" --scoreboard "$repository/docs/SCOREBOARD.md" --dry-run
else
    uv run --locked --project "$repository" python -m phoenix_eval.run_archive gc \
        --workspace "$PHOENIX_ROOT" --scoreboard "$repository/docs/SCOREBOARD.md"
fi
mark="$PHOENIX_ROOT/tmp/.gc-mark"
if [ -f "$mark" ]; then
    for entry in "$PHOENIX_ROOT"/tmp/* "$PHOENIX_ROOT"/tmp/.[!.]* "$PHOENIX_ROOT"/tmp/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        [ "$entry" != "$mark" ] || continue
        case "${entry##*/}" in
            sealed*|holdout*|m1-t0-*|runs|.archive-*|.restore-*) continue ;;
        esac
        if [ ! "$entry" -nt "$mark" ]; then action rm -rf -- "$entry"; fi
    done
fi
action touch "$mark"
action docker builder prune --all --force
action docker image prune --force
docker image ls --format '{{.Repository}} {{.ID}}' | while read -r repository image; do
    case "$repository" in phoenix-*) continue ;; esac
    action docker image rm "$image"
done
action colima ssh -- sudo fstrim -av
printf '%s\n' 'Free space after cleanup:'
df -h "$PHOENIX_ROOT"
