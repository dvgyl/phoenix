{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phoenix lift export",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "image_base", "main", "functions", "imports", "strings", "data_references", "call_edges"],
  "properties": {
    "schema_version": {"const": 1},
    "image_base": {"$ref": "#/$defs/address"},
    "main": {"anyOf": [{"$ref": "#/$defs/main_evidence"}, {"type": "null"}]},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
    "imports": {"type": "array", "items": {"$ref": "#/$defs/import"}},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/string"}},
    "data_references": {"type": "array", "items": {"$ref": "#/$defs/data_reference"}},
    "call_edges": {"type": "array", "items": {"$ref": "#/$defs/call_edge"}}
  },
  "$defs": {
    "evidence_text": {
      "type": "string",
      "maxLength": 1024
    },
    "type_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "name",
        "kind",
        "size",
        "target",
        "count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t(?:0|[1-9][0-9]{0,2})$"
        },
        "path": {
          "$ref": "#/$defs/evidence_text"
        },
        "name": {
          "$ref": "#/$defs/evidence_text"
        },
        "kind": {
          "enum": [
            "opaque",
            "pointer",
            "typedef",
            "array",
            "structure",
            "union",
            "function"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2147483647
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A bounded type description. Size is in bytes. -1 means unknown. Only pointer, typedef, and array links are expanded, to at most 32 nodes per path. Composite members and function signatures stay opaque. IDs follow first encounter within the function."
    },
    "register_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "bits",
        "base",
        "least_bit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/evidence_text"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "bits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "base": {
          "$ref": "#/$defs/evidence_text"
        },
        "least_bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "description": "Register names and addresses for storage pieces and their base registers. This is not a complete language register map."
    },
    "storage_piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "size",
        "register",
        "stack_offset"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "register": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "stack_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "One VariableStorage varnode, in API order. Size is in bytes. Stack offsets use the Ghidra stack-space base, not an inferred runtime stack pointer. A null register preserves an unresolved register name or non-register storage."
    },
    "storage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "size",
        "forced_indirect",
        "auto_parameter",
        "pieces"
      ],
      "properties": {
        "state": {
          "enum": [
            "unknown",
            "bad",
            "unassigned",
            "void",
            "assigned"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "forced_indirect": {
          "type": "boolean"
        },
        "auto_parameter": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "pieces": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/storage_piece"
          }
        }
      }
    },
    "slot_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "storage"
      ],
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "storage": {
          "$ref": "#/$defs/storage_evidence"
        }
      }
    },
    "prototype_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "calling_convention",
        "custom_storage",
        "variadic",
        "no_return",
        "parameters",
        "result"
      ],
      "properties": {
        "source": {
          "enum": [
            "listing",
            "decompiler"
          ]
        },
        "calling_convention": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_storage": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "variadic": {
          "type": "boolean"
        },
        "no_return": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/slot_evidence"
          }
        },
        "result": {
          "$ref": "#/$defs/slot_evidence"
        }
      }
    },
    "jump_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "targets",
        "labels"
      ],
      "properties": {
        "site": {
          "$ref": "#/$defs/optional_address"
        },
        "targets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/optional_address"
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      },
      "description": "HighFunction JumpTable arrays in API order. Labels are signed Java Integer values. Pair labels with targets only when the array lengths match. Repeated targets are valid. Null sites or targets remain unresolved. No exhaustive target-set claim is made."
    },
    "static_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "listing",
        "decompiler",
        "types",
        "registers",
        "jump_tables"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "proposal"
        },
        "listing": {
          "$ref": "#/$defs/prototype_evidence"
        },
        "decompiler": {
          "anyOf": [
            {
              "$ref": "#/$defs/prototype_evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "types": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/type_evidence"
          }
        },
        "registers": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/register_evidence"
          }
        },
        "jump_tables": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/jump_evidence"
          }
        }
      },
      "description": "Optional static proposals, version 1. References are local to this function. The Python reader also checks identities, references, and total limits. These records do not establish verified C types or runtime coverage."
    },
    "main_evidence": {
      "description": "Executable address passed in RDI to the glibc startup function.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "startup", "setup", "call"],
      "properties": {
        "entry": {"$ref": "#/$defs/address"},
        "startup": {"$ref": "#/$defs/address"},
        "setup": {"$ref": "#/$defs/address"},
        "call": {"$ref": "#/$defs/address"}
      }
    },
    "address": {
      "description": "Ghidra address space and unsigned hexadecimal offset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "offset"],
      "properties": {
        "space": {"type": "string", "minLength": 1},
        "offset": {"type": "string", "pattern": "^0x(?:0|[1-9a-f][0-9a-f]{0,15})$"}
      }
    },
    "optional_address": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
    "range": {
      "description": "Inclusive address range.",
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/address"},
        "end": {"$ref": "#/$defs/address"}
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "size", "definition"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "size": {"type": "integer", "minimum": 0},
        "definition": {"$ref": "#/$defs/optional_sequence"}
      }
    },
    "sequence": {
      "description": "Ghidra sequence address and operation number. Raw and analyzed p-code use separate sequences.",
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "index"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "index": {"type": "integer", "minimum": 0}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "opcode", "output", "inputs"],
      "properties": {
        "sequence": {"$ref": "#/$defs/sequence"},
        "opcode": {"type": "string"},
        "output": {"anyOf": [{"$ref": "#/$defs/operand"}, {"type": "null"}]},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/operand"}}
      }
    },
    "optional_sequence": {"anyOf": [{"$ref": "#/$defs/sequence"}, {"type": "null"}]},
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "size", "text", "pcode"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "size": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "pcode": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "statement": {
      "description": "Decompiler statement markup. Address bounds can span gaps.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end", "operation"],
      "properties": {
        "text": {"type": "string"},
        "start": {"$ref": "#/$defs/optional_address"},
        "end": {"$ref": "#/$defs/optional_address"},
        "operation": {"$ref": "#/$defs/optional_sequence"}
      }
    },
    "decompilation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_c", "status", "diagnostic", "analyzed_pcode", "statements"],
      "properties": {
        "raw_c": {"type": ["string", "null"]},
        "status": {"enum": ["ok", "timeout", "incomplete"]},
        "diagnostic": {"type": ["string", "null"]},
        "analyzed_pcode": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "statements": {"type": "array", "items": {"$ref": "#/$defs/statement"}}
      }
    },
    "signature": {
      "description": "Ghidra listing signature. Types use Ghidra data type paths.",
      "type": "object",
      "additionalProperties": false,
      "required": ["calling_convention", "return_type", "parameters", "variadic"],
      "properties": {
        "calling_convention": {"type": ["string", "null"]},
        "return_type": {"type": "string"},
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {"name": {"type": "string"}, "type": {"type": "string"}}
          }
        },
        "variadic": {"type": "boolean"}
      }
    },
    "block": {
      "description": "Instruction block. Ranges include only addresses in the function body.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "ranges"],
      "properties": {
        "entry": {"$ref": "#/$defs/address"},
        "ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}}
      }
    },
    "flow_edge": {
      "description": "Control flow without calls. The destination block can be outside the function.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_block", "to_block", "site", "target", "kind"],
      "properties": {
        "from_block": {"$ref": "#/$defs/address"},
        "to_block": {"$ref": "#/$defs/address"},
        "site": {"$ref": "#/$defs/address"},
        "target": {"$ref": "#/$defs/address"},
        "kind": {"type": "string"}
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "name", "signature", "thunk_target", "ranges", "decompilation", "instructions", "blocks", "flow_edges"],
      "properties": {
        "entry": {"$ref": "#/$defs/address"},
        "name": {"type": "string"},
        "signature": {"$ref": "#/$defs/signature"},
        "thunk_target": {"$ref": "#/$defs/optional_address"},
        "ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "decompilation": {"$ref": "#/$defs/decompilation"},
        "instructions": {"type": "array", "items": {"$ref": "#/$defs/instruction"}},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
        "flow_edges": {"type": "array", "items": {"$ref": "#/$defs/flow_edge"}},
        "static_evidence": {"$ref": "#/$defs/static_evidence"}
      }
    },
    "import": {
      "description": "External symbol. The address in the external library can be unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "library", "name", "library_address"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "library": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "library_address": {"$ref": "#/$defs/optional_address"}
      }
    },
    "string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "value", "type", "size"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "value": {"type": "string"},
        "type": {"type": "string"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "data_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "operand_index"],
      "properties": {
        "from": {"$ref": "#/$defs/address"},
        "to": {"$ref": "#/$defs/address"},
        "kind": {"type": "string"},
        "operand_index": {"type": "integer"}
      }
    },
    "call_edge": {
      "description": "The target is null when Ghidra has no destination. The caller is null outside a known function.",
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "site", "target", "kind", "indirect"],
      "properties": {
        "caller": {"$ref": "#/$defs/optional_address"},
        "site": {"$ref": "#/$defs/address"},
        "target": {"$ref": "#/$defs/optional_address"},
        "kind": {"type": "string"},
        "indirect": {"type": "boolean"}
      }
    }
  }
}
